---
/**
 * La scheda di un appuntamento, per chi l'ha preso.
 *
 * L'indirizzo contiene un codice casuale di sedici byte: è tutta
 * l'autenticazione che serve, e la sola che si può chiedere a un visitatore che
 * non ha e non deve avere un account. Chi ha il link vede il proprio
 * appuntamento e può disdirlo; chi non l'ha non trova niente, e la pagina
 * risponde 404 senza far capire se quel codice esiste.
 *
 * La disdetta è un POST e non un link: un GET che cambia i dati viene eseguito
 * dai precaricamenti dei browser e dagli scanner di sicurezza delle caselle di
 * posta, e un appuntamento sparirebbe perché qualcuno ha passato il mouse sopra
 * il link nell'email.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { query, tryQuery, getSettings } from '../../lib/db.ts';
import {
  agendaPubblica,
  slotAmmesso,
  quandoPerEsteso,
  type AppuntamentoRow,
} from '../../lib/agenda.ts';
import { mailConfig, sendCancellationMail, sendMoveMails } from '../../lib/mail.ts';

const { token = '' } = Astro.params;

async function leggi(): Promise<AppuntamentoRow | null> {
  if (!/^[a-f0-9]{32}$/.test(token)) return null;
  const rows = await tryQuery<AppuntamentoRow>('SELECT * FROM appointments WHERE token = $1', [token]);
  return rows[0] ?? null;
}

let app = await leggi();
let disdettaFatta = false;
let spostatoA: Date | null = null;
let errore = '';

if (Astro.request.method === 'POST' && app) {
  // Riferimento fisso alla riga letta all'inizio: più sotto `app` viene riletto
  // dopo la scrittura, e da lì in poi può essere nullo.
  const attuale = app;
  let azione = '';
  let slotChiesto = '';
  try {
    const form = await Astro.request.formData();
    azione = String(form.get('azione') ?? '');
    slotChiesto = String(form.get('slot') ?? '');
  } catch {
    errore = 'Richiesta non valida.';
  }

  if (azione === 'sposta') {
    /*
      Spostare invece di disdire e riprenotare: fra le due operazioni il nuovo
      orario poteva essere preso da un altro, e chi voleva solo cambiare ora si
      ritrovava senza appuntamento. Qui è un solo passaggio, e se il nuovo orario
      non è più libero quello vecchio resta dov'è.
    */
    const { cfg, giorni } = await agendaPubblica(await getSettings());
    const nuovo = slotAmmesso(giorni, slotChiesto);
    if (attuale.status !== 'confermato') {
      errore = 'Questo appuntamento è stato disdetto: non si può spostare.';
    } else if (attuale.starts_at.getTime() < Date.now()) {
      errore = 'Questo appuntamento è già passato.';
    } else if (!nuovo) {
      errore = 'Quell’orario non è più disponibile. Scegline un altro.';
    } else {
      const prima = attuale.starts_at;
      try {
        await query(
          `UPDATE appointments
              SET starts_at = $1, minutes = $2, version = version + 1, reminded_at = NULL
            WHERE token = $3 AND status = 'confermato'`,
          [nuovo.toISOString(), cfg.minuti, token]
        );
        spostatoA = nuovo;
        app = await leggi();
        // reminded_at torna nullo qui sopra: il promemoria dell'orario vecchio
        // non vale più, e chi ha spostato ne vuole uno per quello nuovo.
        if (app) {
          const esito = await sendMoveMails(app, prima, mailConfig(await getSettings()), Astro.url.origin);
          if (!esito.ok) console.warn(`[prenota] avviso di spostamento non inviato (${esito.error}).`);
        }
      } catch (err) {
        // 23505 indice univoco, 23P01 vincolo di non sovrapposizione: in entrambi
        // i casi qualcuno è arrivato su quell'orario un istante prima.
        const codice = (err as { code?: string }).code;
        if (codice === '23505' || codice === '23P01') {
          errore = 'Quell’orario è stato preso in questo istante da qualcun altro. Scegline un altro.';
        } else {
          console.error('[prenota] spostamento non registrato:', (err as Error).message);
          errore = 'Non è stato possibile spostare l’appuntamento. Scrivimi a info@dextlab.it.';
        }
      }
    }
  }

  if (azione === 'disdici') {
    if (attuale.status !== 'confermato') {
      errore = 'Questo appuntamento era già stato disdetto.';
    } else if (attuale.starts_at.getTime() < Date.now()) {
      // Un appuntamento passato non si disdice: è già accaduto o già mancato, e
      // cambiarlo adesso riscriverebbe la storia senza liberare niente.
      errore = 'Questo appuntamento è già passato: non c’è più niente da disdire.';
    } else {
      try {
        await query("UPDATE appointments SET status = 'disdetto' WHERE token = $1", [token]);
        disdettaFatta = true;
        // L'avviso a chi doveva rispondere: senza, l'orario resta segnato in un
        // calendario personale che nessuno ha aggiornato.
        await sendCancellationMail(attuale, mailConfig(await getSettings()));
        app = await leggi();
      } catch (err) {
        console.error('[prenota] disdetta non registrata:', (err as Error).message);
        errore = 'Non è stato possibile registrare la disdetta. Scrivimi a info@dextlab.it.';
      }
    }
  }
}

if (!app) Astro.response.status = 404;

const attivo = app?.status === 'confermato';
const passato = app ? app.starts_at.getTime() < Date.now() : false;

/*
  L'elenco degli orari si carica solo quando serve: la scheda di un appuntamento
  la si apre per guardare l'ora, e calcolare tre settimane di slot a ogni visita
  sarebbe lavoro buttato. `?sposta=1` è un link vero, quindi il percorso funziona
  anche senza JavaScript come il resto della prenotazione.
*/
const vuoleSpostare = Astro.url.searchParams.get('sposta') === '1' && attivo && !passato;
const { giorni: giorniLiberiOra } = vuoleSpostare
  ? await agendaPubblica(await getSettings())
  : { giorni: [] };

// Come nell'elenco per prenotare: i primi giorni si vedono, gli altri stanno
// dentro un <details>. Tre settimane di orari in fila sono uno scorrimento inutile.
const primiGiorni = giorniLiberiOra.slice(0, 5);
const altriGiorni = giorniLiberiOra.slice(5);
---

<BaseLayout
  title={app ? 'Il tuo appuntamento — Dext Lab' : 'Appuntamento non trovato — Dext Lab'}
  description="Orario, dettagli e disdetta del tuo appuntamento."
  path={`/prenota/${token}`}
  noindex={true}
>
  <div class="bg-glow glow-1" aria-hidden="true"></div>

  <main class="prenota container">
    <a href="/#contatti" class="back">← Torna al sito</a>

    {
      !app ? (
        <header class="pr-testa">
          <h1>Questo appuntamento non c’è</h1>
          <p class="pr-sunto">
            Il link non corrisponde a nessun appuntamento. Può essere incompleto, o
            copiato a metà. Se ti serve un orario, <a href="/prenota">l’agenda è qui</a>.
          </p>
        </header>
      ) : (
        <>
          <header class="pr-testa">
            <h1>
              {spostatoA
                ? 'Appuntamento spostato'
                : attivo
                  ? 'Appuntamento confermato'
                  : 'Appuntamento disdetto'}
            </h1>
            <p class="pr-sunto">
              {attivo
                ? `Ti aspetto ${quandoPerEsteso(app.starts_at)}, ora italiana. Dura ${app.minutes} minuti.`
                : `Era ${quandoPerEsteso(app.starts_at)}. L’orario è di nuovo libero per chiunque.`}
            </p>
          </header>

          {errore && <p class="pr-errore" role="alert">{errore}</p>}

          <dl class="pr-scheda">
            <dt>Quando</dt>
            <dd>{quandoPerEsteso(app.starts_at)} · {app.minutes} minuti · ora italiana</dd>
            <dt>A nome di</dt>
            <dd>{app.name}</dd>
            <dt>Email</dt>
            <dd>{app.email}</dd>
            {app.phone && (
              <>
                <dt>Telefono</dt>
                <dd>{app.phone}</dd>
              </>
            )}
            {app.note && (
              <>
                <dt>Note</dt>
                <dd>{app.note}</dd>
              </>
            )}
          </dl>

          {attivo && !passato && (
            <div class="pr-azioni">
              {/* Il file per il calendario: un appuntamento che resta solo in
                  un'email è un appuntamento che si dimentica. */}
              <a class="btn btn-ghost" href={`/prenota/${token}.ics`} download>
                Aggiungi al calendario
              </a>
              {/* Spostare prima di disdire, e nell'ordine in cui si spera che
                  vengano usati: chi non può più a quell'ora quasi sempre può a
                  un'altra, e un appuntamento spostato è meglio di uno perso. */}
              {!vuoleSpostare && (
                <a class="btn btn-ghost" href={`/prenota/${token}?sposta=1`}>Sposta a un altro orario</a>
              )}
              <form method="POST" action={`/prenota/${token}`}>
                <input type="hidden" name="azione" value="disdici" />
                <button class="btn-disdici" type="submit">Disdici l’appuntamento</button>
              </form>
            </div>
          )}

          {vuoleSpostare &&
            (giorniLiberiOra.length === 0 ? (
              <p class="pr-vuoto">
                Non c’è nessun altro orario libero nei prossimi giorni. Scrivimi a <a
                  href="mailto:info@dextlab.it">info@dextlab.it</a
                > e lo sistemiamo.
              </p>
            ) : (
              <section class="pr-sposta">
                <h2>Scegli il nuovo orario</h2>
                <p class="pr-dettaglio">
                  L’appuntamento di adesso resta valido finché non ne scegli un altro.
                </p>
                {/*
                  Qui gli orari sono pulsanti di un form e non link, perché
                  spostare cambia i dati: un GET che modifica viene eseguito dai
                  precaricamenti del browser, e l'appuntamento si sposterebbe da
                  solo. Vedi il commento in testa al file.
                */}
                <div class="pr-giorni">
                  {primiGiorni.map((g) => (
                    <div class="pr-giorno">
                      <h3>{g.etichetta}</h3>
                      <ul>
                        {g.slot.map((s) => (
                          <li>
                            <form method="POST" action={`/prenota/${token}`}>
                              <input type="hidden" name="azione" value="sposta" />
                              <input type="hidden" name="slot" value={s.iso} />
                              <button type="submit">{s.ora}</button>
                            </form>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                {altriGiorni.length > 0 && (
                  <details class="pr-altri">
                    <summary>Altri {altriGiorni.length} giorni</summary>
                    <div class="pr-giorni">
                      {altriGiorni.map((g) => (
                        <div class="pr-giorno">
                          <h3>{g.etichetta}</h3>
                          <ul>
                            {g.slot.map((s) => (
                              <li>
                                <form method="POST" action={`/prenota/${token}`}>
                                  <input type="hidden" name="azione" value="sposta" />
                                  <input type="hidden" name="slot" value={s.iso} />
                                  <button type="submit">{s.ora}</button>
                                </form>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </details>
                )}
                <p class="pr-nota">
                  Hai cambiato idea? <a href={`/prenota/${token}`}>Torna alla scheda</a>.
                </p>
              </section>
            ))}

          {!attivo && (
            <p class="pr-nota">
              Se ti serve un altro orario, <a href="/prenota">l’agenda è qui</a>.
            </p>
          )}
        </>
      )
    }
  </main>
</BaseLayout>
