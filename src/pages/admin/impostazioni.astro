---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { guardAdmin, handleAdminPost } from '../../lib/admin-actions.ts';
import { csrfToken } from '../../lib/auth.ts';
import { leadStats, contentRows } from '../../lib/admin.ts';
import { qualificaMostrabile } from '../../lib/content.ts';
import { getSettings, setting, settingOn, type CredentialRow } from '../../lib/db.ts';
import { mailConfig, diagnosiSmtp, isMailUsable } from '../../lib/mail.ts';
import { siteUrl } from '../../lib/env.ts';
import { previewToken } from '../../lib/preview.ts';

const denied = guardAdmin(Astro);
if (denied) return denied;

const { response } = await handleAdminPost(Astro, '/admin/impostazioni');
if (response) return response;

const csrf = csrfToken(Astro.cookies);
const [s, leads, qualifiche] = await Promise.all([
  getSettings(),
  leadStats(),
  contentRows<CredentialRow>('credentials'),
]);

/*
  Le qualifiche mostrabili si contano qui perché l'interruttore da solo non basta:
  la pagina /gdpr vuole entrambe le cose. Mostrare la casella senza dire quante
  qualifiche ci sono lascerebbe come unico modo di scoprirlo l'apertura della
  pagina e un 404.
*/
const qualificheOk = qualifiche.filter((c) => c.active && qualificaMostrabile(c)).length;
const dpoOn = settingOn(s, 'dpo_attiva');

/*
  Cosa non torna nella configurazione della posta, calcolato aprendo la pagina e
  non premendo un pulsante. È il difetto che questo sito ha avuto per settimane
  senza che si vedesse: host impostato al server IMAP, modulo che risponde
  «messaggio inviato», e nessuna email mai arrivata. Un pannello che non lo dice
  lascia scoprire il guasto a chi prenota una call e non riceve la conferma.
*/
const cfgMail = mailConfig(s);
const guaiMail = diagnosiSmtp(cfgMail);
const mailUsabile = isMailUsable(cfgMail);

const maintenanceOn = settingOn(s, 'maintenance');
// Token derivato, non APP_SECRET: questo valore finisce in un href.
const previewUrl = `${siteUrl()}/?preview=${previewToken()}`;

/** Un segreto già salvato si segnala senza mostrarlo. */
const hasSecret = (key: string) => setting(s, key) !== '';
const secretHint = (key: string) =>
  hasSecret(key) ? 'salvato — lascia vuoto per non modificarlo' : 'non impostato';
---

<AdminLayout current="settings" title="Impostazioni" newLeads={leads.newCount}>
  <h1>Impostazioni</h1>

  <form method="post" class="settings-form">
    <input type="hidden" name="csrf" value={csrf} />

    <div class:list={['maint-box', { on: maintenanceOn }]}>
      <label class="ck big">
        <input type="checkbox" name="maintenance" checked={maintenanceOn} /> 🛠️ Modalità manutenzione
        {maintenanceOn && <strong>(ATTIVA)</strong>}
      </label>
      <p class="hint">
        Se attiva, i visitatori vedono la pagina di cortesia con il form contatti. Tu continui a
        vedere il sito vero tramite il link di anteprima qui sotto. Le visite vengono comunque
        tracciate.
      </p>
      <label for="maintenance_msg">Messaggio mostrato ai visitatori</label>
      <textarea
        id="maintenance_msg"
        name="maintenance_msg"
        rows="2"
        set:text={setting(
          s,
          'maintenance_msg',
          'Stiamo perfezionando qualcosa di speciale. Torniamo online a brevissimo.'
        )}
      />
      <p style="margin-top:10px">
        <a class="btn-s" href={previewUrl} target="_blank" rel="noopener">
          👁 Anteprima sito vero (bypass manutenzione)
        </a>
      </p>
    </div>

    <h2>Contatti</h2>
    <label for="whatsapp">Numero WhatsApp (formato internazionale, senza +)</label>
    <input id="whatsapp" name="whatsapp" value={setting(s, 'whatsapp')} placeholder="393331234567" />
    <label for="calendly">Link Calendly</label>
    <input
      id="calendly"
      name="calendly"
      value={setting(s, 'calendly')}
      placeholder="https://calendly.com/..."
    />
    <label for="contact_email">Email contatto</label>
    <input
      id="contact_email"
      name="contact_email"
      value={setting(s, 'contact_email')}
      placeholder="info@dextlab.it"
    />

    <h2>SMTP (email)</h2>
    <p class="hint">Senza SMTP i lead vengono salvati e notificati, ma nessuna email parte.</p>
    {
      guaiMail.length > 0 && (
        <div class="maint-box on" style="margin-top:14px">
          <p class="ck big" style="color:#febc2e">Le email non partiranno</p>
          <ul class="smtp-guai">
            {guaiMail.map((g) => (
              <li>{g}</li>
            ))}
          </ul>
          <p class="hint" style="margin:8px 0 0">
            Sono controlli sui valori qui sotto, non sulla connessione: si vedono senza premere
            niente. Dopo averli sistemati usa i due pulsanti in fondo per provare davvero.
          </p>
        </div>
      )
    }
    <label class="ck">
      <input type="checkbox" name="smtp_enabled" checked={settingOn(s, 'smtp_enabled')} /> Usa SMTP
    </label>
    <label for="smtp_host">Host</label>
    <input id="smtp_host" name="smtp_host" value={setting(s, 'smtp_host')} />
    <label for="smtp_user">Utente</label>
    <input id="smtp_user" name="smtp_user" value={setting(s, 'smtp_user')} />
    <label for="smtp_pass">Password <span class="hint">({secretHint('smtp_pass')})</span></label>
    <input id="smtp_pass" name="smtp_pass" type="password" autocomplete="off" placeholder="••••••" />
    <label for="smtp_port">Porta</label>
    <input id="smtp_port" name="smtp_port" value={setting(s, 'smtp_port', '465')} />
    <label for="smtp_secure">Sicurezza (ssl per la porta 465, tls per la 587)</label>
    <input id="smtp_secure" name="smtp_secure" value={setting(s, 'smtp_secure', 'ssl')} />

    <h2>Notifiche Telegram</h2>
    <label class="ck">
      <input type="checkbox" name="tg_enabled" checked={settingOn(s, 'tg_enabled')} /> Notifica su
      Telegram a ogni nuovo lead
    </label>
    <label for="tg_token">Bot token <span class="hint">({secretHint('tg_token')})</span></label>
    <input id="tg_token" name="tg_token" type="password" autocomplete="off" placeholder="••••••" />
    <label for="tg_chat">Chat ID (il tuo, da @userinfobot)</label>
    <input id="tg_chat" name="tg_chat" value={setting(s, 'tg_chat')} placeholder="123456789" />

    <button type="submit" name="action" value="save_settings" class="btn-save">
      Salva impostazioni
    </button>

    {/*
      Le due prove, in ordine di forza. La verifica dice che il server risponde e
      accetta le credenziali; l'email di prova è l'unica cosa che dimostra che un
      messaggio esce davvero e si legge. Sono nello stesso form dei campi ma non
      salvano niente: leggono la configurazione già memorizzata, quindi vanno usate
      dopo aver salvato.
    */}
    <div class="smtp-prove">
      <button type="submit" name="action" value="smtp_verifica" class="btn-s" disabled={!mailUsabile}>
        Verifica la connessione
      </button>
      <button type="submit" name="action" value="smtp_prova" class="btn-s" disabled={!mailUsabile}>
        Mandami una prova a {setting(s, 'contact_email', 'info@dextlab.it')}
      </button>
    </div>
    <p class="hint" style="margin-top:8px">
      {
        mailUsabile
          ? 'Provano la configurazione salvata: se hai appena cambiato un campo, salva prima.'
          : 'Le prove si attivano quando SMTP è acceso e host, utente e password sono compilati.'
      }
    </p>
  </form>

  <p class="hint">
    I campi segreti non vengono ristampati nella pagina: lasciandoli vuoti si conserva il valore già
    salvato. Le impostazioni qui hanno la precedenza sui default passati per variabile d'ambiente.
  </p>

  {/*
    Form separato, con la sua azione: un solo form avrebbe spento le caselle degli
    altri gruppi al primo salvataggio, perché un form HTML non manda le checkbox
    non spuntate. Vedi il commento in src/lib/admin.ts.
  */}
  <form method="post" class="settings-form">
    <input type="hidden" name="csrf" value={csrf} />
    <h2>Zona e ricerca locale</h2>
    <p class="hint">
      Questi campi finiscono nei dati strutturati della home, quelli che Google confronta con la tua
      scheda dell'attività. <strong>Finché sono vuoti la pagina non dichiara nessun dato locale</strong>,
      ed è voluto: un indirizzo o un telefono inventati sono peggio di un campo mancante, perché se
      non combaciano con la scheda il segnale non vale, e se combaciano ma sono falsi il problema non
      è più il posizionamento. Nome, telefono e città devono essere <em>identici</em> a quelli della
      scheda, carattere per carattere.
    </p>

    <label for="biz_name">Nome dell'attività</label>
    <input id="biz_name" name="biz_name" value={setting(s, 'biz_name')} placeholder="Dext Lab" />
    <label for="biz_phone">Telefono pubblico</label>
    <input id="biz_phone" name="biz_phone" value={setting(s, 'biz_phone')} placeholder="+39 333 1234567" />
    <label for="biz_city">Città di riferimento</label>
    <input id="biz_city" name="biz_city" value={setting(s, 'biz_city')} placeholder="Sarzana" />
    <label for="biz_province">Provincia (sigla)</label>
    <input id="biz_province" name="biz_province" value={setting(s, 'biz_province')} placeholder="SP" />
    <label for="biz_region">Regione</label>
    <input id="biz_region" name="biz_region" value={setting(s, 'biz_region')} placeholder="Liguria" />
    <label for="biz_zone">Zone servite, separate da virgole</label>
    <input
      id="biz_zone"
      name="biz_zone"
      value={setting(s, 'biz_zone')}
      placeholder="La Spezia, Massa-Carrara, Lunigiana"
    />
    <p class="hint">
      Le zone sostituiscono l'indirizzo per chi lavora da remoto o a domicilio: è la forma prevista
      per queste attività, non una scorciatoia. Compaiono anche in fondo alla sezione contatti.
    </p>

    <h2>Indirizzo, solo se pubblicabile</h2>
    <p class="hint">
      Da compilare <strong>solo</strong> se c'è una sede e l'indirizzo si può mostrare. Senza via, con
      la sola città, la pagina dichiara la località e non un indirizzo postale — che per un'attività
      senza sede è la cosa corretta.
    </p>
    <label for="biz_street">Via e numero</label>
    <input id="biz_street" name="biz_street" value={setting(s, 'biz_street')} placeholder="" />
    <label for="biz_zip">CAP</label>
    <input id="biz_zip" name="biz_zip" value={setting(s, 'biz_zip')} placeholder="" />
    <label for="biz_lat">Latitudine</label>
    <input id="biz_lat" name="biz_lat" value={setting(s, 'biz_lat')} placeholder="44.1123" />
    <label for="biz_lng">Longitudine</label>
    <input id="biz_lng" name="biz_lng" value={setting(s, 'biz_lng')} placeholder="9.9612" />
    <label for="biz_hours">Orari, come li scrivi tu</label>
    <input id="biz_hours" name="biz_hours" value={setting(s, 'biz_hours')} placeholder="lun-ven 09:00-18:00" />
    <label for="biz_vat">Partita IVA</label>
    <input id="biz_vat" name="biz_vat" value={setting(s, 'biz_vat')} placeholder="" />
    <label for="biz_maps">Indirizzo della scheda Google</label>
    <input id="biz_maps" name="biz_maps" value={setting(s, 'biz_maps')} placeholder="https://maps.app.goo.gl/…" />

    <h2>Profili pubblici</h2>
    <p class="hint">
      Servono a dire che l'attività del sito e quella dei profili sono la stessa. Solo indirizzi
      completi: gli altri vengono scartati.
    </p>
    <label for="social_linkedin">LinkedIn</label>
    <input id="social_linkedin" name="social_linkedin" value={setting(s, 'social_linkedin')} placeholder="https://www.linkedin.com/in/…" />
    <label for="social_github">GitHub</label>
    <input id="social_github" name="social_github" value={setting(s, 'social_github')} placeholder="https://github.com/…" />
    <label for="social_instagram">Instagram</label>
    <input id="social_instagram" name="social_instagram" value={setting(s, 'social_instagram')} placeholder="https://www.instagram.com/…" />
    <label for="social_facebook">Facebook</label>
    <input id="social_facebook" name="social_facebook" value={setting(s, 'social_facebook')} placeholder="https://www.facebook.com/…" />

    <button type="submit" name="action" value="save_locale" class="btn-save">
      Salva i dati della zona
    </button>
  </form>

  <form method="post" class="settings-form" style="margin-top:26px">
    <input type="hidden" name="csrf" value={csrf} />

    <h2>Servizio protezione dati</h2>
    <p class="hint">
      Accende la voce «Protezione dati» nel menu e la pagina <code>/gdpr</code>, dove si racconta
      l'adeguamento privacy dei siti e l'incarico di DPO esterno.
    </p>
    <div class:list={['maint-box', { on: dpoOn }]}>
      <label class="ck big" for="dpo_attiva">
        <input type="checkbox" id="dpo_attiva" name="dpo_attiva" checked={dpoOn} />
        Pubblica la pagina del servizio
        {dpoOn && qualificheOk > 0 && <strong>attiva</strong>}
      </label>
      <p class="hint" style="margin-top:0">
        {dpoOn ? (
          <>
            La pagina è pubblica: <a href="/gdpr" target="_blank" rel="noopener">apri /gdpr</a>. Da
            qui passano anche la voce «Protezione dati» nel menu, la card nei servizi e il piè di
            pagina.
          </>
        ) : (
          'Spunta la casella per pubblicare la pagina del servizio.'
        )}
      </p>
      {/*
        Le qualifiche non decidono se il servizio è in vendita — quello lo decide
        la casella qui sopra. Decidono se il sito DICHIARA una certificazione, e
        senza il dato la pagina descrive il lavoro senza nominare titoli. Detto
        qui perché è la differenza fra le due cose, e altrimenti si scopre
        aprendo la pagina e non trovandoci l'attestato.
      */}
      <p class="hint" style="margin-top:10px">
        {
          qualificheOk === 0 ? (
            <>
              <strong>Nessuna qualifica dichiarata.</strong> La pagina esce comunque, ma non nomina
              nessuna certificazione: senza l'ente che l'ha rilasciata un titolo non è
              verificabile, e questo sito non pubblica affermazioni su di sé che chi legge non possa
              controllare. Il posto per scriverla è già pronto in{' '}
              <a href="/admin/contenuti">Contenuti → Formazione e certificazioni</a>: servono il
              titolo come sta sull'attestato, l'ente, e la spunta «attiva».
            </>
          ) : (
            <>
              {qualificheOk === 1
                ? '1 qualifica dichiarata'
                : `${qualificheOk} qualifiche dichiarate`}: compare in «L'approccio» sulla home, in
              cima alla pagina del servizio e nei dati strutturati.
            </>
          )
        }
      </p>
    </div>

    <button type="submit" name="action" value="save_dpo" class="btn-save">
      Salva il servizio
    </button>
  </form>
</AdminLayout>
