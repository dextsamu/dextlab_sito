---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { guardAdmin, handleAdminPost } from '../../lib/admin-actions.ts';
import { csrfToken } from '../../lib/auth.ts';
import { recentLeads, leadStats, LEAD_STATUSES } from '../../lib/admin.ts';
import { etichettaCampagna } from '../../lib/campagne.ts';
import { dateTime } from '../../lib/format.ts';

const denied = guardAdmin(Astro);
if (denied) return denied;

const { response } = await handleAdminPost(Astro, '/admin/lead');
if (response) return response;

const csrf = csrfToken(Astro.cookies);

/*
  Due elenchi, non uno: i contatti veri e lo spam. Il secondo si apre con
  ?stato=spam, che è un link normale — niente JavaScript, come il resto del
  pannello.

  Sono separati perché lo spam arriva a decine: etichettarlo e lasciarlo in mezzo
  avrebbe spostato il fastidio dalla posta a questa pagina invece di toglierlo.
*/
const soloSpam = Astro.url.searchParams.get('stato') === 'spam';
const [leads, stats] = await Promise.all([recentLeads(300, soloSpam), leadStats()]);
const quantoSpam = stats.byStatus.find((s) => s.status === 'spam')?.count ?? 0;
---

<AdminLayout current="leads" title="Lead" newLeads={stats.newCount}>
  <h1>
    {soloSpam ? 'Spam riconosciuto' : 'Lead ricevuti'}
    <a class="btn-s" href="/admin/lead.csv">Esporta CSV</a>
  </h1>

  {/*
    Il passaggio fra i due elenchi. Il conteggio dello spam si mostra SEMPRE,
    anche a zero: un riconoscimento automatico che nessuno controlla è un
    riconoscimento di cui non si sa se sbaglia, e il primo giorno vale la pena
    aprirlo per vedere cosa ha preso.
  */}
  <p class="hint" style="margin:-6px 0 16px">
    {
      soloSpam ? (
        <>
          Questi contatti sono stati salvati ma <strong>non</strong> ti sono stati notificati. In
          fondo a ogni messaggio c'è il motivo. Se uno è buono, rimettilo a «Nuovo» dal menu a
          destra. <a href="/admin/lead">← torna ai lead veri</a>
        </>
      ) : (
        <>
          <a href="/admin/lead?stato=spam">Spam riconosciuto: {quantoSpam}</a> — salvato ma non
          notificato. Vale la pena aprirlo di tanto in tanto: se ci trovi un contatto vero, il
          riconoscimento è troppo severo e va corretto.
        </>
      )
    }
  </p>

  <table class="leads">
    <thead>
      <tr
        ><th>Data</th><th>Nome</th><th>Email</th><th>Messaggio</th><th>Da dove</th><th>Stato</th><th
        ></th></tr
      >
    </thead>
    <tbody>
      {
        leads.map((lead) => (
          <tr class={`lead-${lead.status}`}>
            <td class="nowrap">{dateTime(lead.created_at)}</td>
            <td>{lead.name}</td>
            <td>
              <a href={`mailto:${lead.email ?? ''}`}>{lead.email}</a>
            </td>
            <td class="msg">
              <strong>{lead.subject}</strong>
              <br />
              {(lead.message ?? '').split(/\r\n|\r|\n/).map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </td>
            {/* Da dove arriva questo contatto. «Diretto» non è un buco nei dati:
                è indirizzo scritto a mano, segnalibro o un link senza
                tracciamento — e per i lead ricevuti prima di questa versione è
                l'unica cosa vera che si può dire. */}
            <td class="lead-da">
              {etichettaCampagna({
                source: lead.camp_source ?? '',
                medium: lead.camp_medium ?? '',
                name: lead.camp_name ?? '',
              })}
              {lead.pagina && <><br /><span class="hint" style="margin:0">{lead.pagina}</span></>}
            </td>
            <td>
              <form method="post" class="inline">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={lead.id} />
                <input type="hidden" name="action" value="lead_status" />
                <select name="status" data-autosubmit>
                  {LEAD_STATUSES.map((s) => (
                    <option value={s.value} selected={lead.status === s.value}>
                      {s.label}
                    </option>
                  ))}
                </select>
              </form>
            </td>
            <td>
              <form method="post" class="inline">
                <input type="hidden" name="csrf" value={csrf} />
                <input type="hidden" name="id" value={lead.id} />
                <button
                  class="btn-s danger"
                  name="action"
                  value="lead_delete"
                  data-confirm="Eliminare il lead?"
                >
                  ✕
                </button>
              </form>
            </td>
          </tr>
        ))
      }
      {
        leads.length === 0 && (
          <tr>
            <td colspan="7" class="hint">Nessun lead ricevuto.</td>
          </tr>
        )
      }
    </tbody>
  </table>
  <p class="hint">Sono mostrati gli ultimi 300 lead. L'export CSV contiene tutto lo storico.</p>
</AdminLayout>
