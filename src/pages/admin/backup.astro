---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { guardAdmin, handleAdminPost } from '../../lib/admin-actions.ts';
import { csrfToken } from '../../lib/auth.ts';
import { leadStats } from '../../lib/admin.ts';
import { listBackups, humanSize, RESTORE_HINT, diagnosiBackup } from '../../lib/backup.ts';
import { dateTime } from '../../lib/format.ts';

const denied = guardAdmin(Astro);
if (denied) return denied;

const { response } = await handleAdminPost(Astro, '/admin/backup');
if (response) return response;

const csrf = csrfToken(Astro.cookies);
/*
  Cosa non torna nella cartella dei backup, calcolato aprendo la pagina e non
  premendo il pulsante. È il difetto che ha tenuto questo sito senza un solo
  backup senza che si vedesse: la cartella montata nel container era di root, ogni
  tentativo finiva in EACCES, e la pagina diceva «Nessun backup ancora. Premi
  Esegui backup ora» — cioè descriveva un guasto con una frase che sembra un
  invito.
*/
const [backups, leads, guaiBackup] = await Promise.all([
  listBackups(),
  leadStats(),
  diagnosiBackup(),
]);
---

<AdminLayout current="backup" title="Backup" newLeads={leads.newCount}>
  <h1>
    Backup database
    <form method="post" class="inline">
      <input type="hidden" name="csrf" value={csrf} />
      <button class="btn-s" name="action" value="run_backup">↓ Esegui backup ora</button>
    </form>
  </h1>

  {
    guaiBackup.length > 0 && (
      <div class="maint-box on" style="margin-bottom:20px">
        <p class="ck big" style="color:#febc2e">Il backup non può funzionare</p>
        <ul class="smtp-guai">
          {guaiBackup.map((g) => (
            <li>{g}</li>
          ))}
        </ul>
        <p class="hint" style="margin:8px 0 0">
          È un controllo sulla cartella, non sul database: si vede senza premere niente. Finché
          resta, «Esegui backup ora» finirà in errore e <strong>non esiste nessuna copia dei tuoi
          dati</strong>.
        </p>
      </div>
    )
  }

  <section class="block">
    {
      backups.length === 0 ? (
        <p class="hint">
          {
            guaiBackup.length > 0
              ? 'Nessun backup, e non è perché non l\'hai ancora chiesto: leggi il riquadro qui sopra.'
              : 'Nessun backup ancora. Premi "Esegui backup ora" oppure configura il cron descritto in DEPLOY.md.'
          }
        </p>
      ) : (
        <table class="leads">
          <thead>
            <tr><th>File</th><th>Data</th><th>Dimensione</th><th /></tr>
          </thead>
          <tbody>
            {backups.map((b) => (
              <tr>
                <td>{b.name}</td>
                <td class="nowrap">{dateTime(new Date(b.time))}</td>
                <td>{humanSize(b.size)}</td>
                <td class="nowrap">
                  <a class="btn-s" href={`/admin/backup/${encodeURIComponent(b.name)}`}>Scarica</a>
                  <form method="post" class="inline">
                    <input type="hidden" name="csrf" value={csrf} />
                    <input type="hidden" name="name" value={b.name} />
                    <button
                      class="btn-s danger"
                      name="action"
                      value="backup_delete"
                      data-confirm="Eliminare questo backup?"
                    >
                      ✕
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>

  <p class="hint">
    Vengono conservati gli ultimi 14 backup, con rotazione automatica. I file stanno in una cartella
    fuori dalla radice pubblica e sono scaricabili solo da qui.
  </p>
  <p class="hint">
    Il dump è completo, schema e dati, prodotto con <code>pg_dump</code>. Per ripristinarlo:
    <code class="restore-cmd">{RESTORE_HINT}</code>
  </p>
</AdminLayout>
