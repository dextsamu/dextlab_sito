---
import AdminLayout from '../../layouts/AdminLayout.astro';
import CrudRow, { type FieldSpec } from '../../components/admin/CrudRow.astro';
import { guardAdmin, handleAdminPost } from '../../lib/admin-actions.ts';
import { csrfToken } from '../../lib/auth.ts';
import { contentRows, leadStats } from '../../lib/admin.ts';

const denied = guardAdmin(Astro);
if (denied) return denied;

const { response } = await handleAdminPost(Astro, '/admin/contenuti');
if (response) return response;

const csrf = csrfToken(Astro.cookies);

const reviewFields: FieldSpec[] = [
  { name: 'quote', type: 'textarea', placeholder: 'Testo recensione' },
  { name: 'author', type: 'text', placeholder: 'Autore' },
  { name: 'role', type: 'text', placeholder: 'Ruolo' },
  { name: 'stars', type: 'number', placeholder: 'stelle' },
  { name: 'sort', type: 'number', placeholder: 'ordine' },
  { name: 'active', type: 'check', placeholder: '' },
];

const workFields: FieldSpec[] = [
  { name: 'title', type: 'text', placeholder: 'Nome del progetto o del cliente' },
  { name: 'url', type: 'text', placeholder: 'https://…' },
  { name: 'summary', type: 'textarea', placeholder: "Una riga: cos'è e cosa fa il sito" },
  { name: 'tags', type: 'text', placeholder: 'Cosa comprendeva, separato da virgole' },
  { name: 'proprio', type: 'check', placeholder: '' },
  { name: 'story', type: 'textarea', placeholder: 'Pagina del lavoro: paragrafi separati da una riga vuota', rows: 8 },
  { name: 'links', type: 'textarea', placeholder: 'Da aprire sul sito: una riga «etichetta | https://…»', rows: 4 },
  { name: 'shots', type: 'textarea', placeholder: 'Didascalie delle schermate, una per riga', rows: 4 },
  { name: 'sort', type: 'number', placeholder: 'ordine' },
  { name: 'active', type: 'check', placeholder: '' },
];

const faqFields: FieldSpec[] = [
  { name: 'question', type: 'text', placeholder: 'Domanda' },
  { name: 'answer', type: 'textarea', placeholder: 'Risposta' },
  { name: 'sort', type: 'number', placeholder: 'ordine' },
  { name: 'active', type: 'check', placeholder: '' },
];

const [reviews, works, faqs, leads] = await Promise.all([
  contentRows('reviews'),
  contentRows('works'),
  contentRows('faqs'),
  leadStats(),
]);
---

<AdminLayout current="content" title="Contenuti" newLeads={leads.newCount}>
  <h1>Contenuti</h1>

  <section class="block">
    <h2>Recensioni</h2>
    {reviews.map((row) => <CrudRow table="reviews" fields={reviewFields} row={row} csrf={csrf} />)}
    <h3>+ Nuova recensione</h3>
    <CrudRow table="reviews" fields={reviewFields} row={null} csrf={csrf} />
    <p class="hint">Le stelle sono limitate fra 1 e 5.</p>
  </section>

  <section class="block">
    <h2>Lavori</h2>
    {works.map((row) => <CrudRow table="works" fields={workFields} row={row} csrf={csrf} />)}
    <h3>+ Nuovo lavoro</h3>
    <CrudRow table="works" fields={workFields} row={null} csrf={csrf} />
    <p class="hint">
      Servono almeno il nome e l'indirizzo: una voce senza uno dei due non viene mostrata, anche se
      è spuntata come attiva. La spunta dopo le etichette è «progetto mio»: distingue un prodotto nato da te da un lavoro su commessa, e sulla scheda compare come etichetta. L'indirizzo è la parte che rende il lavoro verificabile, ed è cliccabile
      dalla scheda. In «cosa comprendeva» le virgole separano le etichette.
    </p>
    <p class="hint">
      Per l'anteprima: metti l'immagine in <code>public/assets/lavori/</code> con il nome del dominio
      senza estensione — per <code>https://esempio.it/</code> il file è <code>esempio.jpg</code>
      (vanno bene anche webp, png, avif). Se non c'è, la scheda mostra il dominio in grande.
    </p>
    <p class="hint">
      Il testo lungo crea la <strong>pagina del lavoro</strong> su
      <code>/lavori/esempio</code>, e sulla scheda compare «Com'è fatto». Se lo lasci vuoto la
      pagina non esiste e la scheda resta com'era: meglio nessuna pagina che una pagina vuota. È il
      posto giusto per quello che solo tu sai — cosa ha chiesto il cliente, cosa hai deciso e
      perché — purché resti verificabile aprendo il sito.
    </p>
    <p class="hint">
      Le schermate in più vanno nella stessa cartella numerate:
      <code>esempio-1.jpg</code>, <code>esempio-2.jpg</code>… La ricerca si ferma al primo numero
      che manca. In «didascalie» scrivi una riga per schermata, nello stesso ordine: le righe in più
      non si vedono, quelle in meno lasciano la schermata senza didascalia.
    </p>
  </section>

  <section class="block">
    <h2>FAQ</h2>
    {faqs.map((row) => <CrudRow table="faqs" fields={faqFields} row={row} csrf={csrf} />)}
    <h3>+ Nuova FAQ</h3>
    <CrudRow table="faqs" fields={faqFields} row={null} csrf={csrf} />
    <p class="hint">Nelle risposte i ritorni a capo vengono conservati sul sito.</p>
  </section>
</AdminLayout>
