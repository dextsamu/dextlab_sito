---
/**
 * Le icone della pagina protezione dati.
 *
 * Stanno tutte in un file, al contrario di quelle dei servizi che sono scritte
 * per esteso una per una: là ogni card ha un disegno diverso e un ciclo avrebbe
 * costretto a scegliere l'icona dal titolo, qui invece sono sedici varianti dello
 * stesso modello — stesso viewBox, stesso tratto, cambia solo il tracciato — e
 * tenerle vicine è il solo modo di vedere se sono coerenti fra loro.
 *
 * Il tratto è 1.6 e il colore è currentColor, come nelle card dei servizi: chi
 * le mette in pagina decide la tinta, non questo file.
 *
 * Sono decorative: `aria-hidden` e nessun titolo. Il significato sta nel testo
 * accanto, e un lettore di schermo che annunciasse «icona lucchetto» prima di una
 * frase che dice già la stessa cosa la direbbe due volte.
 */
interface Props {
  nome: string;
}

const { nome } = Astro.props;

/*
  Un tracciato per nome. Se un nome non esiste non si disegna niente: una pagina
  senza un'icona è meglio di una pagina con l'icona sbagliata, e il buco si vede
  subito in fase di scrittura.
*/
const TRACCIATI: Record<string, string> = {
  // Biscotto morsicato: il cookie, con i suoi punti.
  cookie:
    '<path d="M20.9 11.4a9 9 0 1 1-8.3-8.3 5 5 0 0 0 5 5 4.4 4.4 0 0 0 3.3 3.3Z"/><circle cx="9" cy="10" r=".9" fill="currentColor"/><circle cx="13" cy="14.5" r=".9" fill="currentColor"/><circle cx="8.5" cy="15" r=".7" fill="currentColor"/>',
  // Foglio con righe: l'informativa.
  informativa:
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  // Righe di registro: una per trattamento.
  registro:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v16"/><path d="M11 12.5h6M11 16h4"/>',
  // Nodi collegati: i fornitori che toccano i dati.
  fornitori:
    '<circle cx="5" cy="12" r="2.2"/><circle cx="19" cy="6" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M7 11 17 7M7 13l10 4"/>',
  // Bilancia: la base giuridica. I due piatti pendono dai capi del braccio, non
  // da un punto qualsiasi: una bilancia con i piatti fuori posto non si legge.
  base:
    '<path d="M12 3v18M7 21h10"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>',
  // Orologio con sabbia che scende: la conservazione.
  tempo:
    '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  // Occhio: cosa parte prima del consenso.
  occhio:
    '<path d="M2.5 12S6 6.5 12 6.5 21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.6"/>',
  // Interruttore con la croce: il rifiuto che deve valere.
  rifiuto:
    '<rect x="2.5" y="7.5" width="19" height="9" rx="4.5"/><circle cx="7.5" cy="12" r="2.5"/><path d="M15 10l4 4M19 10l-4 4"/>',
  // Modulo con la casella del consenso: un campo e la casella accanto
  // all'informativa. Tre righe dentro un quadrato le aveva già l'informativa e le
  // aveva il registro; è la casella che fa capire che questo è un modulo.
  // La casella è vuota e non spuntata: a 21px, che è la misura più piccola in cui
  // questa icona compare, la spunta dentro il quadrato diventava una macchia.
  modulo:
    '<rect x="2.5" y="3.5" width="19" height="17" rx="2"/><path d="M6 8.5h12"/><rect x="5.5" y="12.5" width="5.5" height="5.5" rx="1.3"/><path d="M13.5 15.2h4.5"/>',
  // Busta con freccia: dove finiscono i messaggi.
  posta:
    '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m2.5 7 9.5 6.5L21.5 7"/>',
  // Grafico a barre: chi conta le visite.
  statistiche:
    '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  // Dischi impilati: backup e archivi.
  backup:
    '<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6"/><path d="M4.5 12v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6"/>',
  // Coperto: ristoranti e locali.
  locale:
    '<path d="M7 3v8a2.5 2.5 0 0 0 5 0V3M9.5 11v10"/><path d="M17 3c-1.5 1-2.5 2.5-2.5 4.5S15.5 11 17 11.5V21"/>',
  // Sacchetto: negozi online.
  negozio:
    '<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  // Un gruppo di persone: associazioni e volontari. Le spalle sono chiuse a
  // sinistra e a destra invece di essere due archi aperti: aperti si
  // incrociavano, e due cerchi sopra due archi che si incrociano diventano una
  // faccia triste.
  associazione:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  // Cartella con croce: studi e dati sulla salute.
  studio:
    '<rect x="3.5" y="6" width="17" height="14" rx="2"/><path d="M9 6V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V6"/><path d="M12 11v5M9.5 13.5h5"/>',
};

const tracciato = TRACCIATI[nome] ?? '';
---

{
  tracciato && (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={tracciato}
    />
  )
}
