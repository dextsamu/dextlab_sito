---
/**
 * Composizione della landing pubblica. Vive in un componente perché la home
 * scegle fra questa e la pagina di manutenzione, senza passare da un rewrite.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Chrome from './Chrome.astro';
import Nav from './Nav.astro';
import Indice from './Indice.astro';
import Hero from './Hero.astro';
import Servizi from './Servizi.astro';
import Showcase from './Showcase.astro';
import Portfolio from './Portfolio.astro';
import Processo from './Processo.astro';
import Stack from './Stack.astro';
import About from './About.astro';
import Recensioni from './Recensioni.astro';
import Configuratore from './Configuratore.astro';
import Faq from './Faq.astro';
import Contatti from './Contatti.astro';
import Footer from './Footer.astro';
import WhatsAppFloat from './WhatsAppFloat.astro';
import ChatWidget from './ChatWidget.astro';
import CookieBanner from './CookieBanner.astro';
import VisitBeacon from './VisitBeacon.astro';
import { getLandingContent } from '../lib/content.ts';
import { siteUrl } from '../lib/env.ts';
import { versioned } from '../lib/assets.ts';

// Le impostazioni sono già state caricate dal middleware: si riusano invece di
// interrogare di nuovo il database.
const content = await getLandingContent(Astro.locals.settings);

// L'indice del bordo destro. Sta qui e non dentro Indice.astro perché è questo
// file che sa quali sezioni vengono rese davvero: le recensioni ci sono solo se
// il database ne ha di vere, e un trattino che porta al nulla è peggio di un
// trattino in meno. I nomi sono corti di proposito — devono stare su una riga
// accanto al trattino, non ripetere il titolo della sezione.
const sezioni = [
  { id: 'hero', nome: 'Inizio' },
  { id: 'servizi', nome: 'Servizi' },
  { id: 'showcase', nome: 'Il codice' },
  // «Lavori» quando ce ne sono, «Caso reale» quando la sezione mostra solo
  // questo sito: il nome nell'indice deve dire cosa si trova là, non cosa
  // c'era prima.
  { id: 'portfolio', nome: content.works.length > 0 ? 'Lavori' : 'Caso reale' },
  { id: 'processo', nome: 'Processo' },
  { id: 'stack', nome: 'Tecnologie' },
  { id: 'perche', nome: 'Approccio' },
  ...(content.reviews.length > 0 ? [{ id: 'recensioni', nome: 'Recensioni' }] : []),
  { id: 'preventivo', nome: 'Preventivo' },
  { id: 'faq', nome: 'Domande' },
  { id: 'contatti', nome: 'Contatti' },
];

const base = siteUrl();
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Dext Lab',
  description:
    'Realizzazione siti web, web app, e-commerce e consulenza informatica con le migliori tecnologie.',
  url: base,
  email: content.contactEmail,
  image: new URL('/assets/logo-v.png', base + '/').href,
  areaServed: 'IT',
  knowsLanguage: ['it'],
  serviceType: [
    'Realizzazione siti web',
    'Sviluppo web app',
    'Realizzazione e-commerce',
    'Consulenza informatica',
  ],
});
---

<BaseLayout
  title="Dext Lab — Siti web, Web App, E-commerce e Consulenza IT"
  description="Dext Lab realizza siti web, web app ed e-commerce con le migliori tecnologie. Consulenza informatica e prodotti digitali su misura per la tua impresa."
  path="/"
  structuredData={structuredData}
>
  <meta
    slot="head"
    name="keywords"
    content="realizzazione siti web, sviluppo web app, e-commerce, consulenza informatica, sviluppo software, Italia"
  />

  <Chrome />
  {/* La voce «Recensioni» nel menu esiste solo se la sezione esiste: un'ancora
      che porta a niente è peggio di una voce in meno. */}
  <Nav mostraRecensioni={content.reviews.length > 0} />
  <Indice voci={sezioni} />
  <Hero types={content.types} />
  <Servizi />
  <Showcase />
  <Portfolio lavori={content.works} />
  <Processo />
  <Stack />
  {/* Perche.astro non esiste più: le sue righe erano le stesse di About dette
      un'altra volta, e la tabella di confronto parlava di terzi senza prove.
      Vedi il commento in About.astro. */}
  <About />
  {content.reviews.length > 0 && <Recensioni reviews={content.reviews} />}
  <Configuratore types={content.types} addons={content.addons} />
  <Faq faqs={content.faqs} />
  <Contatti contactEmail={content.contactEmail} calendly={content.calendly} />
  <Footer />
  <WhatsAppFloat href={content.whatsappLink} />
  <ChatWidget />
  <CookieBanner />

  {/* Con l'impronta del contenuto, come il foglio di stile: anche questi due
      file erano dichiarati validi sette giorni dal .htaccess di prima. */}
  <script is:inline src={versioned('/js/i18n.js')}></script>
  <script is:inline src={versioned('/js/main.js')}></script>
  <VisitBeacon token={Astro.locals.visitToken} />
</BaseLayout>
