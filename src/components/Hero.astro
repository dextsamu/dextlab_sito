---
/**
 * Prima schermata editoriale: promessa, azione primaria e una prova reale.
 * Il configuratore completo resta più sotto, dove il visitatore ha abbastanza
 * contesto per usarlo; qui il lavoro pubblicato è la dimostrazione immediata.
 */
import { initialEstimate, type PricingItem } from '../lib/content.ts';
import HeroTech from './HeroTech.astro';

interface Props {
  types: PricingItem[];
}

const { types } = Astro.props;

// Qui NON si mostra il prezzo, per scelta. Nella prima schermata una cifra
// tratta al posto tuo prima che il visitatore sappia cosa sta comprando: ancora
// il discorso su un numero, e lo fa nel punto in cui non c'è ancora nessun
// motivo per accettarlo. Il prezzo resta nel configuratore, dove ha accanto le
// funzioni che lo compongono.
// Quello che resta è il tempo, che è l'unico numero che in questa posizione
// gioca a favore: chi cerca qualcuno di veloce lo legge come una promessa, non
// come una richiesta.
const stima = initialEstimate(types);
---

<section class="hero" id="hero">
  <div class="hero-spot" id="heroSpot" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 class="hero-title reveal">
        <span class="hero-title-line">Trasformo idee in</span>
        <span class="hero-title-line grad">prodotti digitali</span>
        <span class="hero-title-line">che funzionano.</span>
      </h1>
      <p class="hero-sub reveal">
        Siti web, web app ed <strong>e-commerce</strong> su misura. Senza template, senza agenzie.
      </p>

      <div class="hero-actions reveal">
        <a href="#contatti" class="btn btn-primary">Iniziamo un progetto</a>
        <a href="#portfolio" class="btn btn-ghost">Guarda i lavori</a>
      </div>

      <ul class="hero-proof reveal" aria-label="Impegni di Dext Lab">
        <li><strong>24 ore</strong><span>per una risposta</span></li>
        <li><strong>Fisso</strong><span>il preventivo scritto</span></li>
        <li><strong>{stima.weeks}</strong><span>per il primo rilascio</span></li>
      </ul>
    </div>

    <HeroTech />
  </div>
</section>
