---
// Barra di navigazione con selettore lingua (gestito da public/js/i18n.js).

interface Props {
  /** Falso quando non ci sono recensioni vere: la voce di menu sparisce con la sezione. */
  mostraRecensioni?: boolean;
  /**
   * Vero quando la pagina del servizio protezione dati è pubblicata. È l'unica
   * voce del menu che porta fuori dalla home, quindi esiste solo se la pagina
   * esiste: le altre sono ancore, e un'ancora rotta si nota subito — un link a
   * una pagina 404 no.
   */
  mostraDpo?: boolean;
}

const { mostraRecensioni = true, mostraDpo = false } = Astro.props;
---

<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="#hero" class="brand" aria-label="Dext Lab home">
      <img src="/assets/logo-h.png" alt="Dext Lab" class="brand-logo" width="400" height="156" />
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="#servizi">Servizi</a>
      <a href="#portfolio">Caso reale</a>
      <a href="#perche">Perché me</a>
      {mostraRecensioni && <a href="#recensioni">Recensioni</a>}
      {mostraDpo && <a href="/gdpr">Protezione dati</a>}
      <span class="lang-switch" role="group" aria-label="Lingua">
        <button type="button" class="lang-btn active" data-lang="it">IT</button>
        <button type="button" class="lang-btn" data-lang="en">EN</button>
      </span>
      <a href="#contatti" class="nav-cta">Contattami</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Apri menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
