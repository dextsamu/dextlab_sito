---
/**
 * Recensioni.
 *
 * Il componente si toglie di mezzo se non ce ne sono: prima le due d'esempio
 * arrivavano dal ripiego in content.ts, quindi la sezione c'era sempre — anche
 * con il database vuoto, anche con il database spento. Ora la sezione esiste
 * solo se esistono le recensioni. Vedi il commento in src/lib/content.ts.
 */
import type { ReviewItem } from '../lib/content.ts';

interface Props {
  reviews: ReviewItem[];
}

const { reviews } = Astro.props;

/** Iniziale dell'autore per l'avatar. Usa Array.from per non spezzare emoji o accenti. */
function initial(author: string): string {
  const first = Array.from(author.trim())[0] ?? '';
  return first.toLocaleUpperCase('it-IT');
}
---

<section class="section section-alt" id="recensioni">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Recensioni</span>
      <h2>Cosa dicono i <span class="grad">clienti</span></h2>
    </div>
    <div class="reviews">
      {
        reviews.map((rv) => (
          <figure class="review reveal">
            <div class="stars">{'★'.repeat(Math.max(1, Math.min(5, rv.stars)))}</div>
            <!-- Le virgolette sono in CSS e non qui: infilate nel nodo di testo
                 rendevano la citazione un'altra stringa rispetto a quella nel
                 database, e il dizionario inglese non la trovava mai. -->
            <blockquote>{rv.quote}</blockquote>
            <figcaption>
              <span class="rv-avatar">{initial(rv.author)}</span>
              <span>
                <strong>{rv.author}</strong>
                {rv.role}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
