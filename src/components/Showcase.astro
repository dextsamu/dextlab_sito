---
const risultati = [
  {
    id: 'richieste',
    numero: '01',
    titolo: 'Più richieste utili',
    problema: 'Le persone arrivano, ma non capiscono subito cosa offri o quale passo fare.',
    intervento: 'Messaggi chiari, percorsi brevi e inviti all’azione messi nel punto giusto.',
    risultato: 'Chi è davvero interessato trova la strada e ti contatta con una richiesta più completa.',
    segnale: 'contatto più chiaro',
  },
  {
    id: 'tempo',
    numero: '02',
    titolo: 'Meno lavoro manuale',
    problema: 'Richieste, prenotazioni e aggiornamenti passano tra messaggi e strumenti scollegati.',
    intervento: 'Moduli, automazioni e pannelli costruiti intorno al tuo modo di lavorare.',
    risultato: 'Le attività ripetitive scorrono da sole e tu recuperi tempo per quelle che contano.',
    segnale: 'flusso più semplice',
  },
  {
    id: 'autonomia',
    numero: '03',
    titolo: 'Più controllo e autonomia',
    problema: 'Ogni modifica dipende da qualcuno e le informazioni importanti restano sparse.',
    intervento: 'Contenuti aggiornabili e dati raccolti in un unico spazio, senza passaggi inutili.',
    risultato: 'Hai uno strumento che puoi capire, gestire e far crescere insieme alla tua attività.',
    segnale: 'gestione più libera',
  },
];
---

<section class="section" id="showcase">
  <div class="container">
    <div class="section-head aperta reveal">
      <span class="eyebrow">Il risultato</span>
      <h2>Non solo un sito. <span class="grad">Un modo più semplice di lavorare.</span></h2>
      <p class="section-lead">
        La tecnologia resta dietro le quinte. Davanti devono esserci risultati concreti,
        facili da usare ogni giorno.
      </p>
    </div>

    <div class="impact-lab reveal" data-impact-lab>
      <div class="impact-tabs" role="tablist" aria-label="Scegli il risultato da esplorare">
        {risultati.map((voce, i) => (
          <button
            class:list={['impact-tab', { 'is-active': i === 0 }]}
            type="button"
            role="tab"
            id={`impact-tab-${voce.id}`}
            aria-controls={`impact-panel-${voce.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-impact-tab={voce.id}
          >
            <span>{voce.numero}</span>
            <strong>{voce.titolo}</strong>
            <i aria-hidden="true">→</i>
          </button>
        ))}
      </div>

      <div class="impact-stage">
        <div class="impact-orbit" aria-hidden="true">
          <span class="impact-core">DEXT LAB</span>
          <i></i><i></i><i></i>
        </div>

        {risultati.map((voce, i) => (
          <article
            class:list={['impact-panel', { 'is-active': i === 0 }]}
            role="tabpanel"
            id={`impact-panel-${voce.id}`}
            aria-labelledby={`impact-tab-${voce.id}`}
            hidden={i !== 0}
            data-impact-panel={voce.id}
          >
            <p class="impact-signal"><span aria-hidden="true"></span>{voce.segnale}</p>
            <h3>{voce.titolo}</h3>
            <div class="impact-flow">
              <div>
                <span>Prima</span>
                <p>{voce.problema}</p>
              </div>
              <i aria-hidden="true">→</i>
              <div>
                <span>Costruiamo</span>
                <p>{voce.intervento}</p>
              </div>
              <i aria-hidden="true">→</i>
              <div class="impact-arrivo">
                <span>Dopo</span>
                <p>{voce.risultato}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <p class="impact-cta reveal">
      Hai già in mente cosa vorresti rendere più semplice?
      <a href="#contatti">Raccontamelo <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>
