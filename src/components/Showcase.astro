---
// Tre mockup animati, ognuno con struttura propria: il CSS li anima tramite
// classi specifiche, quindi il markup resta esplicito.
const chartBars = ['42%', '66%', '38%', '80%', '55%', '96%', '70%'];
---

<section class="section" id="showcase">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Anteprima dal vivo</span>
      <h2>Interfacce che <span class="grad">prendono vita</span></h2>
      <p class="section-lead">
        Non solo parole. Ecco il tipo di esperienze che costruisco — animate, reattive, su misura.
      </p>
    </div>

    <div class="mocks">
      <figure class="mock reveal">
        <div class="browser">
          <div class="browser-bar">
            <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
            <div class="browser-url">dextlab.it</div>
          </div>
          <div class="browser-body">
            <div class="bw-hero">
              <div class="bw-line w60"></div>
              <div class="bw-line w90"></div>
              <div class="bw-btn"></div>
            </div>
            <div class="bw-grid"><span></span><span></span><span></span></div>
          </div>
        </div>
        <figcaption><strong>Siti Web</strong>veloci, responsive, fatti per convertire</figcaption>
      </figure>

      <figure class="mock reveal">
        <div class="window">
          <div class="win-side">
            <span class="ws active"></span><span class="ws"></span><span class="ws"></span><span
              class="ws"></span>
          </div>
          <div class="win-main">
            <div class="win-stats">
              {/* Come le cifre dell'hero: il valore d'arrivo sta nell'HTML, lo
                  zero lo mette il JS appena prima di animare. */}
              <div class="kpi"><span class="kpi-n" data-to="92">92</span><i></i></div>
              <div class="kpi"><span class="kpi-n" data-to="48">48</span><i></i></div>
            </div>
            <div class="chart">
              {chartBars.map((h) => <span style={`--h:${h}`}></span>)}
            </div>
          </div>
        </div>
        <figcaption><strong>Web App</strong>gestionali e dashboard in tempo reale</figcaption>
      </figure>
    </div>
  </div>
</section>
