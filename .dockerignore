# Escluso dal contesto di build: riduce quanto viene inviato al daemon ed evita
# che segreti o artefatti locali finiscano nell'immagine.
.git
.gitignore
.claude

# segreti e configurazione locale
.env
.env.*
!.env.example
deploy-docker/.env

# dipendenze e build: ricostruite dentro l'immagine
node_modules
dist
.astro

# dati di runtime
data
deploy-docker/data
deploy-docker/letsencrypt
*.log

# documentazione
DEPLOY.md
deploy-docker/README.md
