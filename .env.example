# Copia in ".env" per lo sviluppo locale. NON committare il .env.
# In produzione questi valori arrivano da deploy-docker/.env via docker compose.
#
# Nota: non esiste più un config.php da creare a mano sul server. Tutto passa
# da qui, e i segreti obbligatori fanno fallire l'avvio se mancano invece di
# ricadere su un default indovinabile.

# ---- Database PostgreSQL ----
# In alternativa a queste cinque: DATABASE_URL=postgresql://utente:pass@host:5432/db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dext
DB_USER=dext
DB_PASS=

# ---- Segreto applicativo (OBBLIGATORIO, min 32 caratteri) ----
# Firma il cookie di sessione admin e il link di anteprima manutenzione.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ---- URL canonico del sito ----
# Alimenta canonical, Open Graph e sitemap: tenerlo allineato al dominio reale
# evita il disallineamento fra sitemap e host servito.
SITE_URL=http://localhost:4321

# ---- Backup via URL (opzionale) ----
# Se vuota, l'endpoint /api/backup resta disabilitato e il backup si fa solo
# da CLI o dal pannello admin. Generala come APP_SECRET.
BACKUP_KEY=

# ---- Email: default sovrascrivibili da admin -> Impostazioni ----
MAIL_TO=info@dextlab.it
MAIL_FROM=info@dextlab.it
MAIL_FROM_NAME=Dext Lab

# ---- Reverse proxy ----
# Numero di proxy fidati davanti all'app: con il solo Traefik davanti, 1.
# Serve a risalire all'IP reale del visitatore per rate-limit e statistiche.
TRUSTED_PROXY_HOPS=1
