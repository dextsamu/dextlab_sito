# Dext Lab — Apache config (Keliweb)

DirectoryIndex index.php index.html

# Blocca accesso a file sensibili
<FilesMatch "^(config\.php|.*\.db|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# Blocca cartelle interne
RedirectMatch 404 ^/inc/.*$
RedirectMatch 404 ^/backups/.*$

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS (attiva solo quando HTTPS è ok su tutto il dominio)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Forza HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    # dietro reverse proxy (Traefik) il TLS è terminato a monte: non forzare se X-Forwarded-Proto=https
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache statici
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Compressione
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
