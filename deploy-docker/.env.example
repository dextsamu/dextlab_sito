# Copia in ".env" e compila. NON committare .env.

# ---- Dominio ----
# Host su cui Traefik instrada (dominio reale o duckdns/sslip.io per una prova).
SITE_HOST=dextlab.duckdns.org
# URL completo con schema: alimenta canonical, Open Graph e sitemap.
# Deve combaciare con SITE_HOST, altrimenti i motori di ricerca leggono un
# canonical che punta a un altro sito.
SITE_URL=https://dextlab.duckdns.org

# ---- PostgreSQL esistente ----
# DB_HOST è il nome del container Postgres sulla rete "proxy".
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dext
DB_USER=dext
DB_PASS=cambia_password_forte

# Versione del client PostgreSQL installata nell'immagine, per pg_dump.
# Va allineata al server: pg_dump rifiuta di leggere un server più recente di sé.
# Con un Postgres 17: postgresql17-client
PG_CLIENT=postgresql16-client

# ---- Segreto applicativo (OBBLIGATORIO, min 32 caratteri) ----
# Firma i cookie di sessione admin. Se manca, il container non parte.
# Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ---- Backup via URL (opzionale) ----
# Se vuota, /api/backup resta disabilitato e il backup si fa da CLI o dal
# pannello admin. Generala come APP_SECRET.
BACKUP_KEY=

# ---- Email: default sovrascrivibili da admin -> Impostazioni ----
MAIL_TO=info@dextlab.it
MAIL_FROM=info@dextlab.it
MAIL_FROM_NAME=Dext Lab

# ---- Reverse proxy ----
# Numero di proxy fidati davanti all'app: con il solo Traefik, 1.
TRUSTED_PROXY_HOPS=1
